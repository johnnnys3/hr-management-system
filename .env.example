# Copy to .env and fill in real values. Never commit .env.
#
# Values below marked "placeholder" are shape-only for local development,
# per docs/02-project-plan.md §8.2 — not verified rates or real credentials.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost

# PostgreSQL (ADR-0003). Two roles, not one, per docs/07-iam-rbac.md §7.3 /
# docs/02-project-plan.md §7.3: the migration role owns the database and
# runs schema changes (docker-entrypoint.sh's `migrate` step only); the app
# role is what Django and Celery connect as at runtime, and is restricted
# to INSERT/SELECT on audit_log by audit's initial migration. See
# db/init/01-create-app-role.sh, which provisions the app role once against
# an empty postgres_data volume.
POSTGRES_DB=hrms
POSTGRES_MIGRATION_USER=hrms_migrate
POSTGRES_MIGRATION_PASSWORD=change-me
POSTGRES_APP_USER=hrms_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_PORT=5432

# MinIO (ADR-0007) — root credentials for the container, and the
# application-facing access key/secret Django's storage backend uses.
# In this composition they are the same root user; a deployment with
# real data should create a dedicated MinIO service account instead.
MINIO_ROOT_USER=hrms
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=hrms
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=hrms-documents

# Mail dispatch (ADR-0011) — SMTP backend, no provider pinned. Local
# development points at the mailpit service below, which catches mail
# rather than delivering it; a real deployment overrides these to point at
# a real SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=hrms@localhost

# Not set here: CELERY_BROKER_URL, REDIS_CACHE_URL, MINIO_ENDPOINT_URL.
# docker-compose.yml supplies these directly (see the x-backend-env anchor),
# pointing at the redis-broker/redis-cache/minio container hostnames; an
# explicit `environment:` entry in Compose overrides an .env value of the
# same name, so setting them here would have no effect.
