{
	auto_https off
}

:80 {
	# Single origin for the SPA and API, in every environment including local
	# development (ADR-0004, ADR-0009) — the session-cookie auth path is
	# exercised as deployed, not approximated by CORS.

	handle /api/* {
		reverse_proxy django:8000
	}

	handle /static/* {
		root * /srv/static
		file_server
	}

	handle {
		root * /srv/spa
		try_files {path} /index.html
		file_server
	}
}
